# Servidor
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Nível do log em JSON: debug, info, warn, error ou silent. Padrão: info (silent nos testes).
LOG_LEVEL=info

# Banco. Sem DATABASE_URL a API usa PGlite (PostgreSQL em processo) com dados fictícios.
# Para persistir o PGlite em disco, defina PGLITE_DATA_DIR.
DATABASE_URL=
PGLITE_DATA_DIR=
SEED_ON_START=false

# Sessão
JWT_SECRET=troque-por-um-segredo-longo-com-mais-de-32-caracteres
JWT_EXPIRES_IN=8h

# Lista de e-mails liberados (separados por vírgula).
# Em produção é obrigatório informar ALLOWED_EMAILS ou ALLOWED_EMAIL_DOMAINS.
# Login com Microsoft (Entra ID). Os dois são necessários: o ID do aplicativo e a lista de
# locatários (tenants) aceitos, separados por vírgula. Sem eles a rota responde 503.
MICROSOFT_CLIENT_ID=
MICROSOFT_ALLOWED_TENANTS=
# true aceita também contas pessoais (Outlook, Hotmail, Live); o registro do aplicativo precisa permitir esse tipo de conta.
MICROSOFT_ALLOW_PERSONAL=false
ALLOWED_EMAILS=
ALLOWED_EMAIL_DOMAINS=

# Apoio ao desenvolvimento. Nunca ativar em produção (a API recusa iniciar).
AUTH_DEV_LOGIN=true
E2E_TEST_MODE=false
RATE_LIMIT_DISABLED=false

# IA. Sem chaves, a extração de tags e o quebra-gelo usam o caminho manual e o texto padrão.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
AI_TIMEOUT_MS=2500
AI_RETRY_DELAY_MS=500
AI_SLA_MS=8000
AI_BREAKER_FAILURES=3
AI_BREAKER_WINDOW_MS=60000

# Score semântico de tags (Django e FastAPI chegam em Python). Desligado por padrão: gere os vetores com
# `npm run embeddings`, meça com `npm run avaliar-semantica` e só então ligue. Sem vetor, vale o score exato.
SEMANTIC_AFFINITY_ENABLED=false
SEMANTIC_THRESHOLD=0.75
SEMANTIC_WEIGHT=0.5
GEMINI_EMBED_MODEL=gemini-embedding-001
